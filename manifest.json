{
  "manifest_version": 3,
  "name": "Manifold Meter",
  "version": "2.0.5",
  "minimum_chrome_version": "102",
  "author": "linyishan (linyishan@gmail.com)",
  "description": "在 Chrome 工具栏和副屏仪表盘中显示 Codex 5小时额度、本周额度、剩余积分与可用重置。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manifold Meter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/codex/*"],
      "js": ["usage.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
